# Create a key at https://openrouter.ai/keys. Keep the real key in .env.
OPENROUTER_API_KEY=
# The free router chooses an available free model. Override with a model ID
# to prefer a specific model; unavailable models fall back to the free router.
OPENROUTER_MODEL=openrouter/free
# Optional: directory containing pdflatex and xelatex. By default the app checks
# ~/.local/share/resume-tailor/.TinyTeX/bin/x86_64-linux, then PATH.
# LATEX_BIN_DIR=/path/to/texlive/bin/x86_64-linux
